      "parameters": {
        "jsCode": "// Whatever key n8n stored the upload under (data, data0, file, …),\n// make sure it's reachable as `data0` so downstream nodes don't care.\nconst items = $input.all();\nfor (const item of items) {\n  if (item.binary) {\n    const keys = Object.keys(item.binary);\n    if (keys.length > 0 && !item.binary.data0) {\n      item.binary.data0 = item.binary[keys[0]];\n    }\n  }\n}\nreturn items;"
      },
