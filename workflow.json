    {
      "parameters": {
        "jsCode": "const answer = $('Keep Answer Text').first().json.answer;\nconst question = $('Keep Answer Text').first().json.question;\n\nconst binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst audioBase64 = binaryData.toString('base64');\n\nreturn [{\n  json: {\n    answer,\n    question: question || '',\n    audioMime: 'audio/wav',\n    audioBase64\n  }\n}];"
      },
