    {
      "parameters": {
        "jsCode": "// Ensure the upload is reachable as data0, and expose it as base64\n// (+ mime) so the Gemini STT HTTP node can inline it as JSON.\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  if (item.binary) {\n    const keys = Object.keys(item.binary);\n    if (keys.length > 0 && !item.binary.data0) {\n      item.binary.data0 = item.binary[keys[0]];\n    }\n    if (item.binary.data0) {\n      const buf = await this.helpers.getBinaryDataBuffer(i, 'data0');\n      item.json.audioB64 = buf.toString('base64');\n      item.json.audioMime = item.binary.data0.mimeType || 'audio/webm';\n    }\n  }\n}\nreturn items;"
      },
