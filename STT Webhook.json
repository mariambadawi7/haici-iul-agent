    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  \n  if (item.binary) {\n    const keys = Object.keys(item.binary);\n    if (keys.length > 0) {\n      // Grab whatever weird key name the webhook gave the file and standardize it to 'file'\n      const incomingKey = keys[0];\n      item.binary.file = item.binary[incomingKey];\n      \n      // Clean the metadata so Groq accepts it without a 400 bad request\n      item.binary.file.mimeType = 'audio/webm';\n      item.binary.file.fileName = 'speech.webm';\n      item.binary.file.fileExtension = 'webm';\n    }\n  }\n}\n\nreturn items;"
      },
