# Relative URL — Vite proxies /webhook/* to the n8n container internally.
# This keeps the request same-origin from the browser, eliminating CORS.
# The workflow must be Active in n8n; /webhook-test/... fires only once.
VITE_N8N_WEBHOOK_URL=/webhook/rag-agent

# Optional logo overrides (drop files in public/ and set the path here).
VITE_LOGO_LEFT=/logo-center.svg
VITE_LOGO_RIGHT=/logo-iul.svg
VITE_APP_TITLE=IUL Agent
